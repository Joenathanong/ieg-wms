# ---------------------------------------------------------------
# WMS SAP LITE - Environment Variables
# ---------------------------------------------------------------
# TiDB Serverless (protokol MySQL). Ambil dari TiDB Cloud -> Connect ->
# "Connect With" = Prisma. TLS WAJIB: jangan hilangkan sslaccept=strict.
#
#   mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<database>?sslaccept=strict
#
DATABASE_URL="mysql://xxxxxxxx.root:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/wms?sslaccept=strict"

# Catatan: DIRECT_URL tidak dipakai lagi. Itu khusus Neon/PostgreSQL yang
# memisahkan koneksi pooled dan non-pooled; TiDB tidak memerlukannya.

# Secret untuk JWT session (ganti dengan random string minimal 32 karakter)
# WAJIB berbeda antara lingkungan DEV dan PRODUCTION.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Catatan: di production, nilai kosong atau kurang dari 32 karakter membuat
# login DITOLAK. Di lokal, kekosongan masih ditoleransi.
AUTH_SECRET="ganti-dengan-random-string-minimal-32-karakter-yang-aman"

# Password ADMIN awal — dipakai saat database masih kosong sama sekali,
# baik lewat `npm run db:seed -- --minimal` maupun bootstrap login pertama.
# OPSIONAL di lokal (tanpa ini, ADMIN dibuat dengan password admin123).
# WAJIB di production; lihat .env.production.example.
# BOOTSTRAP_ADMIN_PASSWORD=""

# ---------------------------------------------------------------
# Identitas sistem (tampil di status bar & layar logon)
# ---------------------------------------------------------------
# Pemisahan data antar lingkungan dilakukan lewat DATABASE_URL yang berbeda.
# Variabel di bawah HANYA penanda visual supaya operator tidak salah sistem.
#
#   Development : SYSTEM=DEV  CLIENT=100  ENV=DEV   -> penanda kuning "NON-PRODUCTION"
#   Production  : SYSTEM=PRD  CLIENT=300  ENV=PROD  -> tampil normal
NEXT_PUBLIC_SAP_SYSTEM="PRD"
NEXT_PUBLIC_SAP_CLIENT="300"
NEXT_PUBLIC_SAP_ENV="PROD"
