# =====================================================================
#  PRODUCTION — SYSTEM PRD / CLIENT 300
# =====================================================================
#  Salin isi berkas ini ke Environment Variables project Vercel PRODUCTION,
#  atau simpan sebagai .env di lokal SAAT menyiapkan database produksi.
#
#  PENTING: jangan pernah memakai database yang sama dengan DEV (client 100).
#  Pemisahan lingkungan pada aplikasi ini dilakukan lewat DATABASE terpisah.
# ---------------------------------------------------------------------
#
#  DAFTAR LENGKAP — hanya 6 variabel ini yang dibaca aplikasi:
#
#    [ ] DATABASE_URL
#    [ ] BOOTSTRAP_ADMIN_PASSWORD
#    [ ] AUTH_SECRET
#    [ ] NEXT_PUBLIC_SAP_SYSTEM
#    [ ] NEXT_PUBLIC_SAP_CLIENT
#    [ ] NEXT_PUBLIC_SAP_ENV
#
#  Tiga yang berawalan NEXT_PUBLIC_ harus sudah ada SEBELUM build berjalan.
#  Nilainya ditanam ke dalam berkas JavaScript saat build, bukan dibaca ulang
#  saat aplikasi jalan. Menambahkannya setelah deploy tidak akan berpengaruh
#  sampai project di-redeploy — dan gejalanya membingungkan: layar menampilkan
#  angka client bawaan yang berbeda dari yang dibaca server.
# ---------------------------------------------------------------------

# --- Database PRODUCTION (database terpisah di TiDB, mis. "wms_prod") ---
#
# Password WAJIB di-encode bila mengandung @ : / # ? & % atau spasi:
#   node -e "console.log(encodeURIComponent('PASSWORD_ASLI'))"
# Periksa bentuk URL tanpa menghubungi server: npm run db:url
#
# connection_limit & pool_timeout HANYA untuk deploy serverless (Vercel).
# Tiap instance fungsi membuka pool sendiri; tanpa batas ini, lonjakan trafik
# membuka jauh lebih banyak koneksi daripada yang boleh dipegang satu cluster.
# Untuk server biasa yang selalu menyala, HAPUS kedua parameter itu — bawaan
# Prisma sudah tepat dan membatasinya justru memperlambat.
DATABASE_URL="mysql://2Ki1QbvpHXsRNxP.root:CvWV3CV7fhleeywj@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/wms_prod?sslaccept=strict&connection_limit=3&pool_timeout=20"

# Untuk menjalankan `npm run db:push` ke database produksi, pakai URL yang SAMA
# tetapi tanpa connection_limit — perintah itu jalan sekali dari laptop Anda,
# bukan dari fungsi serverless.

# --- Password ADMIN awal ---
# Dipakai `npm run db:seed -- --minimal` dan bootstrap login pertama.
# WAJIB diisi: 'admin123' tertulis di repositori ini, jadi memakainya pada
# alamat yang bisa diakses publik sama saja dengan tidak memasang password.
BOOTSTRAP_ADMIN_PASSWORD="koncedkonced"

# --- Kunci session ---
# WAJIB berbeda dari lingkungan DEV. Buat acak minimal 32 karakter, contoh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Di production, AUTH_SECRET yang kosong atau kurang dari 32 karakter membuat
# login DITOLAK — sengaja, supaya salah isi langsung ketahuan saat deploy dan
# bukan berjalan diam-diam tanpa pengamanan.
AUTH_SECRET="KKitaEkaKitaJayaKitaEkaKitaJayaKitaEkaKitaJayaitaEkaKitaJayaKitaEkaKitaJaya"

# --- Identitas sistem (tampil di status bar & layar logon) ---
NEXT_PUBLIC_SAP_SYSTEM="PRD"
NEXT_PUBLIC_SAP_CLIENT="300"
NEXT_PUBLIC_SAP_ENV="PROD"

# =====================================================================
#  Untuk lingkungan DEV (client 100), pakai nilai berikut:
#    DATABASE_URL              -> database wms_dev
#    AUTH_SECRET                -> string acak LAIN
#    NEXT_PUBLIC_SAP_SYSTEM     -> DEV
#    NEXT_PUBLIC_SAP_CLIENT     -> 100
#    NEXT_PUBLIC_SAP_ENV        -> DEV      (memunculkan badge NON-PRODUCTION)
# =====================================================================
