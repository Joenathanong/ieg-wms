// =====================================================================
//  IEG WMS — Prisma Schema (TiDB Serverless / protokol MySQL)
//  Mengadopsi logika SAP S/4HANA Modul WM (Warehouse Mgmt) & IM (Inventory Mgmt)
//
//  Alur 2-step:
//    MIGO (level IM/MM)  ->  Transfer Requirement  ->  LB10 / LB12 (level WM)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

/// TiDB Serverless memakai protokol MySQL.
/// `relationMode = "prisma"` dipakai karena TiDB Serverless tidak menjamin
/// dukungan foreign key seperti MySQL biasa — integritas relasi ditegakkan
/// Prisma di sisi aplikasi, dan setiap relasi wajib punya index sendiri.
datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum BinStatus {
  EMPTY
  OCCUPIED
  BLOCKED
}

/// Movement Type SAP. Nama simbol Prisma tidak boleh diawali angka,
/// karena itu value asli di database dipetakan lewat @map.
enum MovementType {
  GR_101       @map("101_GR")
  /// Goods issue ke cost center (pemakaian internal)
  GI_201       @map("201_GI")
  /// Goods issue penjualan — dipakai SO Penjualan di pick bin
  GI_601_SALES @map("601_GI_SALES")
  /// Goods receipt tanpa referensi pembelian — retur pelanggan, temuan, hibah,
  /// dan penerimaan lain di luar pembelian. Alurnya sama dengan 101: barang
  /// masuk ke bin transit lebih dulu, lalu di-put-away lewat LB12/ZRF02.
  GR_501_OTHER @map("501_GR_OTHER")
  TR_301_BIN   @map("301_TR_BIN")
  ADJ_551_MIN  @map("551_ADJ_MIN")
  INIT_561     @map("561_INIT_STOCK")
  ADJ_701_PLUS @map("701_ADJ_PLUS")
  ADJ_702_MIN  @map("702_ADJ_MIN")
  /// Movement pembatalan (reversal). Selalu menunjuk dokumen asal via MigoLog.reversal_of
  GR_102_CANC  @map("102_GR_CANCEL")
  GI_202_CANC  @map("202_GI_CANCEL")
  ADJ_552_CANC @map("552_ADJ_CANCEL")
  INIT_562_CANC @map("562_INIT_CANCEL")
  PI_711_CANC  @map("711_PI_CANCEL_MIN")
  PI_712_CANC  @map("712_PI_CANCEL_PLUS")
  GI_602_CANC  @map("602_GI_SALES_CANCEL")
  GR_502_CANC  @map("502_GR_OTHER_CANCEL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum PhysInvStatus {
  CREATED // dokumen dibuat, bin belum di-freeze
  FROZEN // bin di-freeze, siap counting (LI01N)
  COUNTED // hasil counting sudah diinput (LI11N)
  POSTED // selisih sudah di-clearing via 701/702
}

/// Status dokumen SO Penjualan (ZRF09)
enum SalesTakeStatus {
  OPEN // masih dicicil per bin
  CLOSED // ditutup, tidak menerima bin baru
  CANCELLED
}

/// Jenis Transfer Requirement
enum TrType {
  PUTAWAY // dari GR-ZONE ke rak penyimpanan (hasil MIGO 101)
  PICK // dari rak ke GI-ZONE (permintaan MIGO 201)
  INTERNAL // pemindahan internal manual (LT01 / LT10 / PDT)
}

enum TrStatus {
  OPEN
  PARTIAL
  CLOSED
  CANCELLED
}

// ---------------------------------------------------------------------
// MASTER DATA
// ---------------------------------------------------------------------

model Material {
  id               String   @id @default(uuid())
  material_code    String   @unique
  description      String   @db.VarChar(255)
  uom              String   @default("PC") @db.VarChar(16)
  is_batch_managed Boolean  @default(true)
  min_safety_stock Int      @default(0)
  /// Barcode B-POM (registrasi BPOM) — dipakai lookup scan PDT
  barcode_bpom     String?
  /// Barcode produk (EAN/UPC kemasan) — dipakai lookup scan PDT
  barcode_produk   String?
  /// Kode OCS — identifier panjang, mis. GIMMICK-HANASUI-EYEMAZING-EYESHADOW-PALETTE-SUNSET
  kode_ocs         String?  @db.VarChar(255)
  /// Fix bin — bin picking tetap material ini; saran tujuan replenishment ZRF08
  fix_bin          String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  packagings PackagingType[]

  @@index([description])
  @@index([barcode_bpom])
  @@index([barcode_produk])
  @@index([kode_ocs])
  @@map("materials")
}

/// Tabel palletization — material x tipe storage unit x kelompok gudang.
/// Contoh: FG-0001 = 1000 PC per PAL di Gudang Besar, 100 PC per BINBOX di Gudang Kecil.
/// Dipakai MIGO untuk auto-split qty menjadi beberapa line pallet.
model PackagingType {
  id            String   @id @default(uuid())
  material_code String
  material      Material @relation(fields: [material_code], references: [material_code], onDelete: Cascade)
  /// kode kemasan, contoh: PALLET-STD, PALLET-HALF, BOX-24
  pack_code     String
  /// tipe storage unit: PAL | BINBOX | CTN
  su_type       String   @default("PAL")
  /// kelompok gudang: BESAR | KECIL | null (berlaku untuk semua)
  zone_group    String?
  description   String   @default("") @db.VarChar(255)
  /// jumlah base UoM per 1 unit kemasan (mis. 1000 PC per pallet)
  qty_per_unit  Int
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([material_code, pack_code])
  @@index([material_code])
  @@index([material_code, zone_group])
  @@map("packaging_types")
}

/// Master Cost Center — tujuan pembebanan biaya untuk goods issue 201.
/// Dikelola lewat T-Code KS01.
model CostCenter {
  id          String   @id @default(uuid())
  /// contoh: CC-PROD-01, CC-MAINT
  cost_center String   @unique
  description String   @db.VarChar(255)
  /// departemen / pemilik anggaran, bebas diisi
  department  String?  @db.VarChar(255)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([is_active])
  @@map("cost_centers")
}

/// Master Zone / Storage Section (padanan Storage Type di SAP WM).
/// Sebelumnya hanya konstanta di src/lib/zones.ts; kini jadi master data
/// yang dikelola lewat T-Code ZZONE.
model Zone {
  id          String   @id @default(uuid())
  /// contoh: GB-HDR, GB-PICK, GK-BIN, TRANSIT-IN
  zone_code   String   @unique
  label       String   @db.VarChar(255)
  /// kelompok gudang untuk palletization: BESAR | KECIL | TRANSIT | LAIN
  zone_group  String   @default("LAIN")
  /// contoh format bin yang disarankan, dipakai sebagai hint di LS01N
  bin_pattern String?
  /// bin di zona ini adalah bin interim (transit in/out), bukan lokasi final
  is_interim  Boolean  @default(false)
  /// zona pick face — sumber pengambilan eceran (dipakai ZRF08)
  is_pick     Boolean  @default(false)
  /// zona nonaktif tidak muncul saat membuat bin baru, tapi bin lama tetap valid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([is_active])
  @@index([zone_group])
  @@map("zones")
}

model StorageBin {
  id            String    @id @default(uuid())
  /// Format: Aisle-Rack-Level, contoh: A-01-02-1
  bin_code      String    @unique
  /// contoh: RACK-FAST, RACK-HEAVY, RACK-BINBOX, PICK-BIN, TRANSIT, GR-ZONE, GI-ZONE
  zone_id       String
  max_weight_kg Float     @default(1000)
  status        BinStatus @default(EMPTY)
  /// true untuk GR-ZONE / GI-ZONE — bin interim, tidak dihitung sebagai lokasi penyimpanan final
  is_interim    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([zone_id])
  @@index([status])
  @@index([is_interim])
  @@map("storage_bins")
}

/// SO Penjualan — perhitungan sisa fisik pick bin (T-Code ZRF09).
///
/// Barang di pick bin diambil oleh program picking di luar sistem ini, jadi
/// saldo buku selalu lebih tinggi dari fisik. Selisihnya diakui sebagai
/// penjualan (movement 601). Dokumen sengaja DICICIL: satu dokumen bisa
/// mencakup beberapa bin yang dihitung bertahap per shift.
model SalesTakeDoc {
  id         String          @id @default(uuid())
  doc_number String          @unique
  status     SalesTakeStatus @default(OPEN)
  /// penanda periode / shift, mis. "SHIFT-1 13.08"
  reference  String?      @db.VarChar(255)
  remarks    String?      @db.VarChar(255)
  created_by String
  created_at DateTime        @default(now())
  closed_at  DateTime?

  items SalesTakeItem[]

  @@index([status])
  @@map("sales_take_docs")
}

model SalesTakeItem {
  id            String       @id @default(uuid())
  doc_id        String
  doc           SalesTakeDoc @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  bin_code      String
  material_code String
  batch_number  String?
  /// saldo buku SAAT dihitung — dikunci supaya replenishment yang masuk
  /// belakangan tidak ikut terhitung sebagai penjualan
  book_qty      Int
  /// sisa fisik hasil hitung operator
  actual_qty    Int
  /// book - actual bila positif -> diposting sebagai GI penjualan (601)
  sold_qty      Int          @default(0)
  /// actual - book bila positif -> diposting sebagai penyesuaian (701)
  surplus_qty   Int          @default(0)
  /// nomor material document hasil posting
  gi_document   String?
  adj_document  String?
  counted_by    String
  counted_at    DateTime     @default(now())

  @@index([doc_id])
  @@index([bin_code])
  @@map("sales_take_items")
}

// ---------------------------------------------------------------------
// STOCK
// ---------------------------------------------------------------------

/// Global Inventory Management Stock (level plant / MB52)
model StockIM {
  id            String   @id @default(uuid())
  material_code String   @unique
  total_qty     Int      @default(0)
  updated_at    DateTime @updatedAt

  @@map("stock_im")
}

/// Warehouse Management Stock — level Bin & Batch (LX02)
model StockWM {
  id            String    @id @default(uuid())
  material_code String
  bin_code      String
  /// null jika material tidak batch-managed
  batch_number  String?
  mfg_date      DateTime?
  exp_date      DateTime?
  /// tanggal goods receipt quant ini (diisi saat 101/561, ikut terbawa saat transfer 301)
  gr_date       DateTime?
  qty           Int       @default(0)
  updated_at    DateTime  @updatedAt

  /// Kunci unik gudang: 1 material + 1 bin + 1 batch = 1 baris quant
  @@unique([material_code, bin_code, batch_number], name: "quant_key")
  @@index([material_code])
  @@index([bin_code])
  @@index([exp_date])
  @@map("stock_wm")
}

// ---------------------------------------------------------------------
// TRANSACTION / AUDIT TRAIL (MB51)
// ---------------------------------------------------------------------

model MigoLog {
  id              String       @id @default(uuid())
  document_number String       @unique
  movement_type   MovementType
  material_code   String
  source_bin      String?
  target_bin      String?
  batch_number    String?
  qty             Int
  uom             String       @default("PC")
  reference       String?      @db.VarChar(255)
  remarks         String?      @db.VarChar(255)
  /// cost center pembebanan — wajib untuk movement 201 (GI Cost Center)
  cost_center     String?
  /// nomor Transfer Requirement terkait (bila ada)
  tr_number       String?
  doc_date        DateTime     @default(now())
  created_at      DateTime     @default(now())
  user_id         String
  /// true bila diposting lewat terminal PDT (ZRF)
  via_pdt         Boolean      @default(false)
  /// nomor dokumen ASAL yang dibatalkan oleh dokumen ini (khusus movement pembatalan)
  reversal_of     String?
  /// nomor dokumen PEMBATALAN — diisi pada dokumen asal saat dibatalkan
  reversed_by     String?

  @@index([material_code])
  @@index([movement_type])
  @@index([doc_date])
  @@index([created_at])
  @@index([tr_number])
  @@index([reversal_of])
  @@index([cost_center])
  @@map("migo_logs")
}

/// Penomoran dokumen ala SAP (number range object)
model DocumentCounter {
  id       String @id @default(uuid())
  /// contoh: MATDOC, TRDOC, PIDOC, TRREQ
  key      String @unique
  last_num Int    @default(0)

  @@map("document_counters")
}

// ---------------------------------------------------------------------
// TRANSFER REQUIREMENT — LB10 / LB12
// ---------------------------------------------------------------------

model TransferReq {
  id         String   @id @default(uuid())
  tr_number  String   @unique
  tr_type    TrType
  status     TrStatus @default(OPEN)
  /// nomor material document asal (MIGO 101) bila ada
  ref_doc    String?
  reference  String?  @db.VarChar(255)
  remarks    String?  @db.VarChar(255)
  /// cost center pembebanan untuk TR PICK (201) — dibawa ke dokumen goods issue
  cost_center String?
  created_by String
  created_at DateTime @default(now())
  closed_at  DateTime?

  items TransferReqItem[]

  @@index([status])
  @@index([tr_type])
  @@index([created_at])
  @@map("transfer_reqs")
}

model TransferReqItem {
  id            String      @id @default(uuid())
  tr_id         String
  tr            TransferReq @relation(fields: [tr_id], references: [id], onDelete: Cascade)
  line_no       Int
  material_code String
  batch_number  String?
  mfg_date      DateTime?
  exp_date      DateTime?
  /// kemasan yang dipakai saat split (mis. PALLET-STD)
  pack_code     String?
  qty           Int
  qty_confirmed Int         @default(0)
  /// PUTAWAY: bin interim asal. PICK: diisi operator saat konfirmasi.
  source_bin    String?
  /// PUTAWAY: diisi operator saat konfirmasi. PICK: bin interim tujuan.
  target_bin    String?
  status        TrStatus    @default(OPEN)

  @@index([tr_id])
  @@index([material_code])
  @@map("transfer_req_items")
}

// ---------------------------------------------------------------------
// PHYSICAL INVENTORY / STOCK OPNAME (LI01N / LI11N / LI21)
// Satu dokumen dapat mencakup BANYAK bin dan banyak baris.
// ---------------------------------------------------------------------

model PhysInvDoc {
  id           String        @id @default(uuid())
  doc_number   String        @unique
  /// BIN_LIST | ZONE | ALL — cara pemilihan cakupan dokumen
  scope_type   String        @default("BIN_LIST")
  /// deskripsi cakupan, mis. "RACK-FAST" atau "A-01-01-1, A-01-02-1"
  scope_value  String        @default("") @db.VarChar(500)
  /// Daftar bin yang di-freeze dokumen ini, dipisah koma.
  /// MySQL/TiDB tidak punya tipe array — konversi ke array dilakukan di
  /// lapisan API lewat `fromDbList`/`toDbList` (src/lib/dblist.ts).
  /// Tanpa @default: MySQL/TiDB melarang DEFAULT pada kolom TEXT.
  /// Nilainya selalu diisi saat create (lihat api/physinv/route.ts).
  frozen_bins  String        @db.Text
  /// Daftar material yang menjadi CAKUPAN dokumen, dipisah koma.
  ///
  /// null = seluruh isi rak dihitung (perilaku LI01N). Berisi daftar = opname
  /// terfokus: hanya material inilah yang di-snapshot, dihitung, dan masuk
  /// jurnal. Material lain yang kebetulan ada di rak yang sama sengaja TIDAK
  /// ikut tercatat sejak awal — bukan disaring belakangan — supaya tidak ada
  /// jalan bagi mereka bocor ke penyesuaian stok sebagai selisih minus hanya
  /// karena tidak ada yang menghitungnya.
  scope_materials String?     @db.Text
  status       PhysInvStatus @default(CREATED)
  /// Ronde penghitungan yang sedang berjalan. Dokumen LI01N biasa berhenti di 1.
  current_round Int          @default(1)
  planned_date DateTime      @default(now())
  counted_at   DateTime?
  posted_at    DateTime?
  created_by   String
  created_at   DateTime      @default(now())

  items   PhysInvDocItem[]
  bins    PhysInvBin[]
  rounds  PhysInvRound[]
  assigns PhysInvAssign[]

  @@index([status])
  @@map("phys_inv_docs")
}

/// Satu RONDE penghitungan dalam sebuah dokumen opname.
///
/// Opname besar jarang selesai sekali jalan: bila dua orang menghitung rak yang
/// sama dan hasilnya berbeda, rak itu dihitung ulang di ronde berikutnya oleh
/// orang lain. Angka diterima ketika dua ronde SEPAKAT — jadi hasil tiap ronde
/// harus tersimpan berdampingan, tidak boleh saling menimpa.
///
/// Pengaturan blind disimpan di sini, bukan per petugas: bila dalam satu ronde
/// sebagian orang buta dan sebagian melihat angka sistem, kedua hitungan tidak
/// setara dan konsensus yang terbentuk lebih lemah daripada kelihatannya.
model PhysInvRound {
  id      String     @id @default(uuid())
  doc_id  String
  doc     PhysInvDoc @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  round   Int
  /// false = petugas TIDAK melihat jumlah menurut sistem saat menghitung
  show_book_qty   Boolean @default(false)
  /// false = petugas TIDAK melihat hasil ronde sebelumnya
  show_prev_round Boolean @default(false)
  opened_at DateTime  @default(now())
  opened_by String
  closed_at DateTime?

  @@unique([doc_id, round])
  @@index([doc_id])
  @@map("phys_inv_rounds")
}

/// Penugasan penghitungan PER MATERIAL dalam satu ronde.
///
/// Dipakai oleh opname terfokus (ZSO01 dengan daftar material). Aturannya:
/// satu material dikerjakan tepat satu orang, tetapi satu orang boleh memegang
/// banyak material. `@@unique([doc_id, round, material_code])` menegakkan sisi
/// pertama di tingkat database — bukan sekadar di layar — sehingga tidak ada
/// jalan membagi satu material ke dua penghitung, baik lewat layar maupun lewat
/// pemanggilan API langsung.
///
/// Alasannya bukan kerapian: bila material yang sama dihitung dua orang di rak
/// berbeda, tidak ada satu pun angka yang utuh untuk dibandingkan, dan selisih
/// yang muncul berasal dari pembagian kerja, bukan dari kenyataan di gudang.
///
/// Opname bercakupan ZONA atau SELURUH GUDANG tidak memakai tabel ini; di sana
/// penugasan tetap melekat pada rak (PhysInvBin.assigned_to), karena tidak ada
/// daftar material yang bisa dijadikan satuan pembagian.
model PhysInvAssign {
  id            String     @id @default(uuid())
  doc_id        String
  doc           PhysInvDoc @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  round         Int
  material_code String
  assigned_to   String
  created_at    DateTime   @default(now())

  @@unique([doc_id, round, material_code])
  @@index([doc_id, round])
  @@index([assigned_to])
  @@map("phys_inv_assigns")
}

/// Status penghitungan PER BIN dalam satu dokumen opname.
///
/// Dibutuhkan karena opname besar dikerjakan banyak orang secara paralel dan
/// tidak berurutan: tanpa penanda ini, bin yang memang KOSONG tidak bisa
/// dibedakan dari bin yang belum didatangi (bin kosong tidak punya baris item).
model PhysInvBin {
  id         String     @id @default(uuid())
  doc_id     String
  doc        PhysInvDoc @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  bin_code   String
  /// ronde tempat baris ini berlaku — satu rak punya satu baris per ronde
  round      Int        @default(1)
  /// username petugas yang ditugaskan. null = siapa saja boleh (alur LI01N lama)
  assigned_to String?
  /// null = belum dihitung
  counted_at DateTime?
  counted_by String?

  @@unique([doc_id, bin_code, round])
  @@index([doc_id])
  @@index([doc_id, round])
  @@index([assigned_to])
  @@map("phys_inv_bins")
}

model PhysInvDocItem {
  id            String     @id @default(uuid())
  doc_id        String
  doc           PhysInvDoc @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  /// bin per baris — memungkinkan satu dokumen mencakup banyak bin
  bin_code      String
  /// ronde penghitungan yang menghasilkan baris ini.
  /// Ronde 1 juga menyimpan snapshot book_qty saat freeze.
  round         Int        @default(1)
  material_code String
  batch_number  String?
  /// diisi untuk baris TEMUAN (barang tidak tercatat): batch baru belum punya
  /// quant, jadi tanggalnya harus ikut direkam saat menghitung supaya FEFO benar
  mfg_date      DateTime?
  exp_date      DateTime?
  /// snapshot stok sistem saat freeze
  book_qty      Int        @default(0)
  /// hasil hitung fisik
  counted_qty   Int?
  /// counted_qty - book_qty
  diff_qty      Int        @default(0)
  posted        Boolean    @default(false)
  /// Penanda pasangan koreksi batch: baris batch lama (dihitung 0) dan baris
  /// batch pengganti berbagi nilai yang sama. Dipakai laporan untuk memisahkan
  /// "tertukar batch" dari "selisih stok" — tanpa ini, satu kekeliruan batch
  /// terhitung dua kali sebagai temuan dan akurasi opname terlihat jauh lebih
  /// buruk daripada kenyataannya.
  swap_group    String?    @db.VarChar(64)
  /// true = angka inilah yang dipakai sebagai hasil akhir dan diposting.
  /// Diisi otomatis saat dua ronde sepakat, atau dipilih supervisor bila tidak.
  is_final      Boolean    @default(false)
  counted_by    String?

  @@index([doc_id])
  @@index([bin_code])
  @@index([doc_id, round])
  @@map("phys_inv_doc_items")
}

// ---------------------------------------------------------------------
// USER MANAGEMENT (SU01) & SYSTEM SETTINGS (ZSET)
// ---------------------------------------------------------------------

/// Role otorisasi T-Code (ala PFCG). Berisi daftar T-Code yang boleh dibuka.
/// User tanpa role = akses penuh sesuai role dasar (ADMIN/OPERATOR/VIEWER).
model AuthRole {
  id          String   @id @default(uuid())
  role_name   String   @unique
  description String   @default("") @db.VarChar(255)
  /// daftar T-Code yang diizinkan, mis. ["MIGO","MB51","ZRF04","ZRF08"]
  /// Daftar T-Code yang diizinkan, dipisah koma (lihat src/lib/dblist.ts).
  /// Tanpa @default: MySQL/TiDB melarang DEFAULT pada kolom TEXT.
  tcodes      String   @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users User[]

  @@map("auth_roles")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  full_name     String    @db.VarChar(255)
  password_hash String
  role          UserRole  @default(OPERATOR)
  is_active     Boolean   @default(true)
  /// izin membuka T-Code terminal PDT (ZRF*) — diatur admin di SU01
  pdt_enabled   Boolean   @default(false)
  /// Boleh DITUGASKAN pekerjaan stock opname (ZSO01/ZSO02).
  ///
  /// Dipisahkan dari `pdt_enabled` dengan sengaja. Bisa membuka ZRF05 tidak
  /// sama dengan layak diberi jatah opname: supervisor sering punya akses PDT
  /// untuk memeriksa, tetapi tidak ikut menghitung. Menugaskan rak kepada orang
  /// yang tidak menghitung membuat opname menggantung tanpa ada yang sadar.
  ///
  /// Bawaannya true agar pemasangan yang sudah berjalan tidak mendadak kehilangan
  /// seluruh daftar petugasnya; admin tinggal mematikan yang tidak perlu.
  so_enabled    Boolean   @default(true)
  /// role otorisasi T-Code (PFCG). null = tidak dibatasi (full sesuai role dasar)
  auth_role_id  String?
  auth_role     AuthRole? @relation(fields: [auth_role_id], references: [id], onDelete: SetNull)
  last_login    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([auth_role_id])
  @@map("users")
}

/// Konfigurasi sistem key-value (ZSET) — mis. PDT_ENABLED, DEFAULT_GR_BIN
model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
  updated_by String   @default("SYSTEM")

  @@map("system_settings")
}
